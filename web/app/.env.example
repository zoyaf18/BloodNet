# Local development should use the same-origin proxy with an empty API URL so the
# browser talks to the local FastAPI backend on 127.0.0.1:8080 instead of a stale gateway URL.
VITE_BLOODNET_ENV=local


# Production compliance defaults: set these when enabling the hardened deployment boundary.
BLOODNET_SECRET_MANAGER_NAME=projects/YOUR_GCP_PROJECT_ID/secrets/bloodnet-jwt
BLOODNET_SECRET_ROTATION_SCHEDULE=0 3 * * 1
BLOODNET_CMEK_KEY=projects/YOUR_GCP_PROJECT_ID/locations/us/keyRings/bloodnet/cryptoKeys/bloodnet-key
BLOODNET_VPC_SERVICE_CONTROLS_PERIMETER=accessPolicies/123456789/servicePerimeters/bloodnet
BLOODNET_DLP_TEMPLATE=projects/YOUR_GCP_PROJECT_ID/deidentifyTemplates/bloodnet-dlp

# Set only through the authenticated frontend deployment pipeline.
# Tokens are obtained at runtime from the configured identity provider.
# Important: the Firebase web API key is public and identifies the client app.
# Do not treat it as a secret: lock it down via Firebase API restrictions,
# Identity Platform rules, backend authorization, and server-side verification.
VITE_IDENTITY_PLATFORM_API_KEY=AIzaSyAFsIbCSiQh2o7tuZTNwPof8f50T8T_ujg
VITE_IDENTITY_PLATFORM_AUTH_DOMAIN=project-bae56d7f-3ee2-48fc-bdd.firebaseapp.com
VITE_IDENTITY_PLATFORM_PROJECT_ID=project-bae56d7f-3ee2-48fc-bdd
VITE_BLOODNET_API_BASE_URL=
VITE_BLOODNET_GATEWAY_API_KEY=

# Backend-only: email that receives role-request notifications. The account must
# still authenticate and be explicitly allowed to approve requests.
BLOODNET_ROLE_APPROVER_EMAIL=zoya1804@gmail.com
